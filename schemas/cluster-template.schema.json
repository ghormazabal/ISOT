{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "isot:schemas/cluster-template",
  "title": "Template: cluster-templates/<nombre>/template.yaml (o sites/<sitio>/cluster-templates/...)",
  "type": "object",
  "required": [
    "template_name"
  ],
  "properties": {
    "template_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Igual al nombre de la carpeta; lo citan los clústeres en template_ref."
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "distro": {
      "type": [
        "string",
        "null"
      ]
    },
    "kubernetes_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "cni": {
      "type": "object",
      "properties": {
        "primary": {
          "type": [
            "string",
            "null"
          ]
        },
        "defaults": {
          "type": "object"
        }
      }
    },
    "charts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Nombre del release (único en el template)."
          },
          "repo": {
            "type": [
              "string",
              "null"
            ]
          },
          "chart": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "description": "Fija la versión (K8S-VER-003 si falta)."
          },
          "namespace": {
            "type": [
              "string",
              "null"
            ]
          },
          "order": {
            "type": [
              "integer",
              "number"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "values_ref": {
            "type": [
              "string",
              "null"
            ],
            "description": "Ruta relativa a la carpeta del template (values/<archivo>.yaml)."
          },
          "values_inline": {}
        }
      }
    },
    "rule_overrides": {
      "$ref": "#/$defs/rule_overrides"
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "ip": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f:.]+(/[0-9]{1,3})?$",
      "description": "IPv4/IPv6, con o sin prefijo (10.0.0.5 o 10.0.0.5/24)."
    },
    "cidr": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$",
      "description": "Red en notación CIDR (10.0.0.0/24)."
    },
    "vlan": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4094,
      "description": "VLAN 802.1Q (1-4094)."
    },
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "`nombre` (mismo sitio) o `sitio/nombre`."
    },
    "rule_overrides": {
      "type": "array",
      "description": "Cambia la severidad de una regla en este alcance. Sin reason no aplica (RULE-OVR-001).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Id de regla, p.ej. K8S-CP-001 (ver docs/rules.md)."
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "info",
              "off"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Por qué se acepta la desviación (obligatorio)."
          }
        }
      }
    }
  }
}
