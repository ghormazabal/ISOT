{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "isot:schemas/device",
  "title": "Dispositivo: sites/<sitio>/devices/<tipo>/<HOSTNAME>.yaml",
  "description": "Un archivo por dispositivo. <tipo> (baremetal, network, virtual-machines, ...) es la carpeta y agrupa el grafo.",
  "type": "object",
  "required": [
    "hostname",
    "role"
  ],
  "properties": {
    "hostname": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
      "description": "Clave del dispositivo en el sitio; igual al nombre del archivo."
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "description": "Rol funcional (spine, server-leaf, mgmt, worker, control-plane, storage, ...)."
    },
    "kind": {
      "type": [
        "string",
        "null"
      ],
      "description": "baremetal, network, vm, ... (informativo; el grafo usa la carpeta)."
    },
    "vendor": {
      "anyOf": [
        {
          "type": [
            "string",
            "null"
          ]
        },
        {
          "type": "null"
        },
        {
          "const": ""
        }
      ]
    },
    "model": {
      "anyOf": [
        {
          "type": [
            "string",
            "null"
          ]
        },
        {
          "type": "null"
        },
        {
          "const": ""
        }
      ]
    },
    "hw_model": {
      "anyOf": [
        {
          "type": [
            "string",
            "null"
          ]
        },
        {
          "type": "null"
        },
        {
          "const": ""
        }
      ]
    },
    "os": {
      "anyOf": [
        {
          "type": [
            "string",
            "null"
          ]
        },
        {
          "type": "null"
        },
        {
          "const": ""
        }
      ]
    },
    "serial": {
      "anyOf": [
        {
          "type": [
            "string",
            "null"
          ]
        },
        {
          "type": "null"
        },
        {
          "const": ""
        }
      ]
    },
    "k8s_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cluster_ref": {
      "description": "Clúster al que pertenece: nombre, sitio/nombre o {name, site}. null/vacío: sin clúster.",
      "anyOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "null"
        },
        {
          "const": ""
        },
        {
          "type": "object",
          "anyOf": [
            {
              "required": [
                "name"
              ]
            },
            {
              "required": [
                "ref"
              ]
            }
          ],
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "site": {
              "$ref": "#/$defs/name"
            }
          }
        }
      ]
    },
    "pair": {
      "type": [
        "string",
        "null"
      ],
      "description": "Hostname del otro switch del par MLAG/ESI."
    },
    "leaf_pair": {
      "type": [
        "string",
        "null"
      ],
      "description": "Id del par de leafs (agrupa el grafo)."
    },
    "networking": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Interfaz lógica o física. Genera una arista si tiene connected_to.",
        "anyOf": [
          {
            "required": [
              "interface"
            ]
          },
          {
            "required": [
              "name"
            ]
          }
        ],
        "properties": {
          "interface": {
            "type": [
              "string",
              "null"
            ],
            "description": "Nombre de la interfaz (eth0, Management0, VLAN_X)."
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Alias de interface."
          },
          "parent": {
            "type": [
              "string",
              "null"
            ],
            "description": "Bond o interfaz física que la transporta."
          },
          "vlan": {
            "anyOf": [
              {
                "$ref": "#/$defs/vlan"
              },
              {
                "type": "null"
              },
              {
                "const": ""
              }
            ]
          },
          "ip": {
            "anyOf": [
              {
                "$ref": "#/$defs/ip"
              },
              {
                "type": "null"
              },
              {
                "const": ""
              }
            ]
          },
          "gateway": {
            "anyOf": [
              {
                "$ref": "#/$defs/ip"
              },
              {
                "type": "null"
              },
              {
                "const": ""
              }
            ]
          },
          "mac": {
            "anyOf": [
              {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9A-Fa-f]{2}([:-][0-9A-Fa-f]{2}){5}$"
              },
              {
                "type": "null"
              },
              {
                "const": ""
              }
            ]
          },
          "mtu": {
            "type": "integer",
            "minimum": 576
          },
          "network": {
            "type": [
              "string",
              "null"
            ],
            "description": "Nombre de subred de la topología."
          },
          "vrf": {
            "type": [
              "string",
              "null"
            ]
          },
          "connected_to": {
            "type": "object",
            "required": [
              "device"
            ],
            "description": "Extremo remoto. device debe existir en el sitio (o en `site`); si no, INV-REF-001.",
            "properties": {
              "device": {
                "$ref": "#/$defs/ref"
              },
              "site": {
                "$ref": "#/$defs/name"
              },
              "port": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Puerto del peer (Ethernet1/1, PortChannel10, br-x)."
              }
            }
          }
        }
      }
    },
    "bonds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "description": "Bond/LAG. leaf_pc genera una arista por switch (panel Conexión).",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "mode": {
            "type": [
              "string",
              "null"
            ],
            "description": "lacp, active-backup, ..."
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "leaf_pc": {
            "type": "object",
            "description": "{SWITCH: puerto} en cada switch del par.",
            "additionalProperties": {
              "type": [
                "string",
                "integer",
                "null"
              ]
            }
          },
          "allowed_vlans": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/vlan"
            }
          },
          "extra_host_vlans": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/vlan"
            }
          },
          "mtu": {
            "type": "integer",
            "minimum": 576
          }
        }
      }
    },
    "oob": {
      "type": "object",
      "description": "Gestión fuera de banda (BMC). switch+port generan una arista hacia el switch MGMT.",
      "properties": {
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "ip": {
          "anyOf": [
            {
              "$ref": "#/$defs/ip"
            },
            {
              "type": "null"
            },
            {
              "const": ""
            }
          ]
        },
        "switch": {
          "anyOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            },
            {
              "const": ""
            }
          ]
        },
        "port": {
          "type": [
            "string",
            "null"
          ]
        },
        "vlan": {
          "anyOf": [
            {
              "$ref": "#/$defs/vlan"
            },
            {
              "type": "null"
            },
            {
              "const": ""
            }
          ]
        },
        "undocumented_peer": {
          "type": "boolean",
          "description": "true: el switch OOB no está documentado; no se dibuja arista."
        }
      }
    },
    "hypervisor": {
      "type": "object",
      "description": "Solo VMs: host físico que la ejecuta.",
      "properties": {
        "device": {
          "anyOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            },
            {
              "const": ""
            }
          ]
        },
        "cluster": {
          "type": [
            "string",
            "null"
          ]
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "bgp": {
      "type": "object",
      "properties": {
        "asn": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "router_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ip"
            },
            {
              "type": "null"
            },
            {
              "const": ""
            }
          ]
        }
      }
    },
    "vlans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vlan"
      }
    },
    "mtu": {
      "type": "integer",
      "minimum": 576
    },
    "rule_overrides": {
      "$ref": "#/$defs/rule_overrides"
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "ip": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f:.]+(/[0-9]{1,3})?$",
      "description": "IPv4/IPv6, con o sin prefijo (10.0.0.5 o 10.0.0.5/24)."
    },
    "cidr": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$",
      "description": "Red en notación CIDR (10.0.0.0/24)."
    },
    "vlan": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4094,
      "description": "VLAN 802.1Q (1-4094)."
    },
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "`nombre` (mismo sitio) o `sitio/nombre`."
    },
    "rule_overrides": {
      "type": "array",
      "description": "Cambia la severidad de una regla en este alcance. Sin reason no aplica (RULE-OVR-001).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Id de regla, p.ej. K8S-CP-001 (ver docs/rules.md)."
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "info",
              "off"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Por qué se acepta la desviación (obligatorio)."
          }
        }
      }
    }
  }
}
