{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "isot:schemas/ingest-gaps",
  "title": "_ingest/gaps.yaml: datos desconocidos y conflictos",
  "type": "object",
  "required": [
    "version",
    "gaps"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "entity",
          "kind",
          "status",
          "detail"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "entity": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(?:(?:site|address_space):[A-Za-z0-9][A-Za-z0-9._-]*|template:(?:[A-Za-z0-9][A-Za-z0-9._-]*/)?[A-Za-z0-9][A-Za-z0-9._-]*|(?:device|cluster|subnet|vlan):[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*)$",
            "description": "<tipo>:<nombre> o <tipo>:<sitio>/<nombre>."
          },
          "field": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "kind": {
            "enum": [
              "unknown",
              "conflict",
              "ambiguous"
            ]
          },
          "status": {
            "enum": [
              "open",
              "needs-human",
              "resolved"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/source_ref"
            }
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "value",
                "source"
              ],
              "properties": {
                "value": {},
                "source": {
                  "$ref": "#/$defs/source_ref"
                }
              }
            }
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "conflict"
                }
              }
            },
            "then": {
              "required": [
                "candidates"
              ],
              "properties": {
                "candidates": {
                  "minItems": 2
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "resolved"
                }
              }
            },
            "then": {
              "required": [
                "resolution"
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "required": [
        "source",
        "file"
      ],
      "properties": {
        "source": {
          "type": [
            "string",
            "null"
          ],
          "description": "id de una fuente de _ingest/state.yaml."
        },
        "file": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Ruta del archivo dentro de la fuente."
        },
        "locator": {
          "type": [
            "string",
            "integer"
          ],
          "description": "Línea, fila, hoja!celda o sección."
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "note": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        }
      }
    }
  }
}
