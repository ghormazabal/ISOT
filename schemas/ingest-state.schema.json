{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "isot:schemas/ingest-state",
  "title": "_ingest/state.yaml: última revisión procesada de cada fuente",
  "type": "object",
  "required": [
    "version",
    "isot_version",
    "processed_at",
    "sources"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "isot_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "processed_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}",
      "description": "Fecha ISO (YYYY-MM-DD[THH:MM...])."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "repo"
        ],
        "anyOf": [
          {
            "required": [
              "commit"
            ],
            "properties": {
              "commit": {
                "type": "string"
              }
            }
          },
          {
            "required": [
              "files"
            ],
            "properties": {
              "files": {
                "minItems": 1
              }
            }
          }
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "repo": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "pattern": "^(?![a-zA-Z][a-zA-Z0-9+.-]*://[^/@]*@)",
            "description": "URL o ruta relativa, sin credenciales."
          },
          "ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "commit": {
            "anyOf": [
              {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{7,64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
