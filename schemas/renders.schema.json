{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "isot:schemas/renders",
  "title": "renders.yaml del repositorio de datos",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "target_dir": {
      "type": "string",
      "description": "Carpeta destino por defecto, dentro de este mismo repo de datos (rendered). ISoT nunca escribe en otro repositorio."
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Instancia de render.",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
          },
          "template": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$",
            "description": "Id del template de render."
          },
          "site": {
            "type": "string",
            "description": "Sitio (en sites/<id>/renders.yaml es implícito)."
          },
          "cluster": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_dir": {
            "type": [
              "string",
              "null"
            ],
            "description": "Carpeta destino propia, dentro de este mismo repo de datos (por defecto la target_dir global)."
          },
          "dir": {
            "type": [
              "string",
              "null"
            ],
            "description": "Subcarpeta dentro de la carpeta destino (por defecto <site>/<cluster o site>/<template>)."
          },
          "params": {
            "type": "object"
          },
          "enabled": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "template"
        ],
        "additionalProperties": false
      }
    }
  }
}
