{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "isot:schemas/sites",
  "title": "Catálogo: sites.yaml",
  "type": "object",
  "properties": {
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,31}$",
            "description": "Id corto en minúsculas; carpeta sites/<id>."
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ],
            "description": "Por defecto sites/<id>."
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "address_spaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sites"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "sites": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2
          },
          "match": {
            "type": "object",
            "properties": {
              "subnets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "vlans": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/vlan"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "ip": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f:.]+(/[0-9]{1,3})?$",
      "description": "IPv4/IPv6, con o sin prefijo (10.0.0.5 o 10.0.0.5/24)."
    },
    "cidr": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$",
      "description": "Red en notación CIDR (10.0.0.0/24)."
    },
    "vlan": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4094,
      "description": "VLAN 802.1Q (1-4094)."
    },
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "description": "`nombre` (mismo sitio) o `sitio/nombre`."
    },
    "rule_overrides": {
      "type": "array",
      "description": "Cambia la severidad de una regla en este alcance. Sin reason no aplica (RULE-OVR-001).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Id de regla, p.ej. K8S-CP-001 (ver docs/rules.md)."
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "info",
              "off"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Por qué se acepta la desviación (obligatorio)."
          }
        }
      }
    }
  }
}
